# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.

# Supabase — Settings > API Keys
# Nomenclatura nueva: publishable key -> ANON_KEY, secret key -> SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. Solo se lee en Server Actions o Route Handlers, jamas en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — visible en la URL del dashboard: /dashboard/project/<ref>
SUPABASE_PROJECT_REF=

# Contrasena de la base de datos, para 'supabase link' y conexiones directas
SUPABASE_DB_PASSWORD=

# Tasa de cambio — DolarAPI, sin API key
EXCHANGE_API_URL=https://ve.dolarapi.com/v1/dolares

# Cadena aleatoria larga, protege el endpoint de sincronizacion de tasas
CRON_SECRET=
